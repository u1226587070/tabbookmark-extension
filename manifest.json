{
  "manifest_version": 3,
  "name": "TabBookmark Switcher",
  "version": "1.0.0",
  "description": "弹窗显示书签或标签页，Tab/书签模式一键切换",
  "permissions": [
    "bookmarks",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "弹出书签/标签页选择窗口"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabBookmark Switcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
