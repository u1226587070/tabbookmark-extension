{
  "manifest_version": 3,
  "name": "TabBookmark Switcher",
  "version": "1.0.0",
  "description": "在页面上显示书签栏浮层，方向键导航，数字键跳转",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "显示/隐藏书签导航浮层"
    },
    "nav-left": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "Command+Shift+Comma"
      },
      "description": "上一个书签 (←)"
    },
    "nav-right": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "下一个书签 (→)"
    },
    "nav-open": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "打开当前高亮的书签"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabBookmark Switcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
